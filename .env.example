DATABASE_URL=postgresql://user:password@host:5432/database

# Authentication is required by default in production.
HADI_STUDIO_AUTH_REQUIRED=true
HADI_STUDIO_OWNER=hadi
HADI_STUDIO_PASSWORD=replace-with-a-long-private-owner-password
HADI_AUTH_SECRET=replace-with-at-least-32-random-characters

# Optional read-only account.
HADI_STUDIO_AUDITOR=auditor
HADI_STUDIO_AUDITOR_PASSWORD=

# Only set false for local HTTP testing/CI. Keep unset in HTTPS production.
# HADI_COOKIE_SECURE=false
